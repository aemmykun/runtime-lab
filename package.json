{
  "name": "runtime-lab-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "npm run build -w @runtime-lab/core && npm run build -w runtimes-lab && npm run build -w @runtime-lab/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspaces",
    "dev": "npm run dev -w @runtime-lab/web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "smoke": "npm run smoke -w @runtime-lab/web",
    "preview": "npm run preview -w @runtime-lab/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
